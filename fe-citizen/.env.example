# ===== Municipal Tax Portal — Citizen frontend configuration =====
# Copy this file to `.env.local` for development.
# For production static builds, set NEXT_PUBLIC_API_URL in the Render
# dashboard (it is embedded into the static bundle at build time).

# Base URL of the NestJS backend, WITHOUT a trailing `/api`
# (the frontend appends `/api` itself). Examples:
#   Local dev:  NEXT_PUBLIC_API_URL=http://localhost:8000
#   Production: NEXT_PUBLIC_API_URL=https://municipal-tax-be.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy server-era variable, kept as a fallback (lib/env.ts prefers
# NEXT_PUBLIC_API_URL when both are set).
API_URL=http://localhost:8000
