# ===== Municipal Tax Portal — Backend configuration =====
# Copy this file to `.env` and adjust the values for your environment.

# --- Server ---
PORT=8000
NODE_ENV=development

# --- CORS (required for the static frontend deployments) ---
# Comma-separated exact origins of the deployed frontends (no trailing slash).
# Example: CORS_ORIGIN=https://municipal-tax-admin.onrender.com,https://municipal-tax-citizen.onrender.com
# Local dev: CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Unset/empty = same-origin only (no cross-origin requests with credentials).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL) ---
# Localhost path (dev) — used only when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=egov_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# --- Database (Neon Postgres, preferred) ---
# Pooled URL serves app traffic; direct (unpooled) URL is for migrations/seeds.
# Pulled via `neon deploy` into `.env.local`, then copied into `be/.env`.
# When set, DATABASE_URL takes precedence over DB_HOST* above.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Super Admin seed ---
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@municipaltax.gov.np
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PHONE_NUMBER=+9779876543210
SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- App ---
APP_NAME=Municipal Tax Portal
BCRYPT_SALT_ROUNDS=10

# --- Mock online-payment provider (development only) ---
# HMAC secret used to sign/verify mock eSewa server callbacks.
# Set a strong random value; never commit production secrets.
MOCK_PAY_SECRET=change_me_mock_pay_secret

# --- Document storage (local development) ---
# Uploaded ownership documents are stored under this directory and served
# only through authorized API endpoints (never a public static route).
DOCUMENT_STORAGE_PATH=./uploads/documents
